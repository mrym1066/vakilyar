# ======================================================
# فایل تنظیمات محیطی وکیل‌یار
# این فایل را کپی کنید به .env و مقادیر را تنظیم کنید
# ======================================================

# کلید امنیتی — حتماً عوض کنید (python -c "import secrets; print(secrets.token_urlsafe(50))")
SECRET_KEY=your-very-secret-key-here-change-this

# در production این را False کنید
DEBUG=False

# آدرس‌های مجاز (با کاما جدا کنید)
ALLOWED_HOSTS=localhost,127.0.0.1,yourdomain.com

# ایمیل
EMAIL_HOST_PASSWORD=your-email-password
